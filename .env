# PaymentLab defaults. Override any value here or with a profile file:
#   ./lab.ps1 up -EnvFile limits.tight.env
COMPOSE_PROJECT_NAME=paymentlab

# ---- images (verified to exist) ----------------------------------------
POSTGRES_IMAGE=postgres:18-alpine
RABBITMQ_IMAGE=rabbitmq:4.4-management-alpine
TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.13.0

# ---- resource limits ----------------------------------------------------
GATEWAY_MEM=256m
GATEWAY_CPUS=0.5
PAYMENTS_MEM=384m
PAYMENTS_CPUS=1.0
WALLET_MEM=384m
WALLET_CPUS=1.0
CONNECTOR_MEM=128m
CONNECTOR_CPUS=0.5
FAKEBANK_MEM=128m
FAKEBANK_CPUS=0.25
PAYMENTS_DB_MEM=1024m
PAYMENTS_DB_CPUS=1.5
WALLET_DB_MEM=768m
WALLET_DB_CPUS=1.5
RABBITMQ_MEM=512m
RABBITMQ_CPUS=1.0
TOXIPROXY_MEM=64m
TOXIPROXY_CPUS=0.25

# ---- application tuning --------------------------------------------------
PAYMENTS_DB_POOL=50
WALLET_DB_POOL=50
PAYMENTS_DB_SHARED_BUFFERS=256MB
WALLET_DB_SHARED_BUFFERS=192MB
PG_MAX_CONNECTIONS=200
CONNECTOR_PREFETCH=20
PAYMENTS_PREFETCH=50
GATEWAY_RATE_LIMIT=200
FAKEBANK_LATENCY_MS=50
FAKEBANK_JITTER_MS=50
FAKEBANK_REJECT_RATE=0.02
