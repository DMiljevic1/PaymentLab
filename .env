# PaymentLab defaults. Override any value here or with a profile file:
#   ./lab.ps1 up -EnvFile limits.tight.env
COMPOSE_PROJECT_NAME=paymentlab

# ---- images (verified to exist) ----------------------------------------
POSTGRES_IMAGE=postgres:18-alpine
RABBITMQ_IMAGE=rabbitmq:4.4-management-alpine
TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.13.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.165.0
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
LOKI_IMAGE=grafana/loki:3.7.10
TEMPO_IMAGE=grafana/tempo:2.10.10
GRAFANA_IMAGE=grafana/grafana:13.2.6
PG_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.20.1
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.61.0
K6_IMAGE=grafana/k6:2.4.0

# ---- resource limits ----------------------------------------------------
GATEWAY_MEM=256m
GATEWAY_CPUS=0.5
PAYMENTS_MEM=384m
PAYMENTS_CPUS=1.0
WALLET_MEM=384m
WALLET_CPUS=1.0
CONNECTOR_MEM=128m
CONNECTOR_CPUS=0.5
FAKEBANK_MEM=128m
FAKEBANK_CPUS=0.25
PAYMENTS_DB_MEM=1024m
PAYMENTS_DB_CPUS=1.5
WALLET_DB_MEM=768m
WALLET_DB_CPUS=1.5
RABBITMQ_MEM=512MB   # MB unit: also passed to RabbitMQ
RABBITMQ_CPUS=1.0
TOXIPROXY_MEM=128m
TOXIPROXY_CPUS=1.0   # every DB / AMQP / HTTP hop goes through it
# observability
OTEL_COLLECTOR_MEM=256m
OTEL_COLLECTOR_CPUS=0.5
PROMETHEUS_MEM=512m
PROMETHEUS_CPUS=0.5
LOKI_MEM=384m
LOKI_CPUS=0.5
TEMPO_MEM=512m
TEMPO_CPUS=0.5
GRAFANA_MEM=384m
GRAFANA_CPUS=0.5
PG_EXPORTER_MEM=64m
PG_EXPORTER_CPUS=0.1
CADVISOR_MEM=192m
CADVISOR_CPUS=0.25
# load generator (only while ./lab.ps1 load runs)
K6_MEM=768m
K6_CPUS=1.0

# ---- application tuning --------------------------------------------------
PAYMENTS_DB_POOL=50
WALLET_DB_POOL=50
PAYMENTS_DB_SHARED_BUFFERS=256MB
WALLET_DB_SHARED_BUFFERS=192MB
PG_MAX_CONNECTIONS=200
CONNECTOR_PREFETCH=20
PAYMENTS_PREFETCH=50
GATEWAY_RATE_LIMIT=200
FAKEBANK_LATENCY_MS=50
FAKEBANK_JITTER_MS=50
FAKEBANK_REJECT_RATE=0.02
PROMETHEUS_RETENTION=3d
