        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{service=~\"$service\"}[$__rate_interval])) / (max by (service) (container_spec_cpu_quota{service=~\"$service\"}) / max by (service) (container_spec_cpu_period{service=~\"$service\"}))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "id": 3
    },
