{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "TokenLimit": 200,
    "TokensPerSecond": 200
  },
  "ReverseProxy": {
    "Routes": {
      "payments": {
        "ClusterId": "payments",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/payments/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "accounts": {
        "ClusterId": "wallet",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/accounts/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "payments": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "payments": { "Address": "http://localhost:8081/" } }
      },
      "wallet": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "wallet": { "Address": "http://localhost:8082/" } }
      }
    }
  }
}
